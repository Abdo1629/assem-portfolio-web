# Copy to .env.local and set values locally. Do not commit real secrets.
GEMINI_API_KEY=
# Optional override
GEMINI_MODEL=gemini-2.5-flash

# Admin access
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token: repository Contents read/write only
GITHUB_TOKEN=
GITHUB_REPOSITORY=Abdo1629/assem-portfolio-web
# Publishing commits directly to this branch and may trigger a Vercel deployment
ADMIN_CONTENT_BRANCH=main

# Optional, only after the owner confirms the address
NEXT_PUBLIC_CONTACT_EMAIL=
